<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Game Scores</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #111;
      color: #fff;
      margin: 0;
      padding: 40px 20px;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      background: #222;
      border-radius: 12px;
      border: 2px solid #444;
      padding: 28px;
    }

    h1 {
      margin-top: 0;
      text-align: center;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 12px;
      border-bottom: 1px solid #444;
      text-align: left;
    }

    th {
      background: #333;
    }

    .empty {
      color: #aaa;
      font-style: italic;
    }

    #backButton {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 26px;
      border: 0;
      border-radius: 10px;
      background: #00f5ff;
      color: #071018;
      font-weight: 900;
      font-size: 16px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Scores</h1>

    <% if (!scores || scores.length === 0) { %>
      <p class="empty">No scores yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Score</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% scores.forEach((entry) => { %>
            <tr>
              <td><%= entry.name || 'Anonymous' %></td>
              <td><%= entry.score || 0 %></td>
              <td><%= entry.date ? new Date(entry.date).toLocaleString() : 'Unknown' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <button id="backButton">Back to Game</button>
  </div>

  <script>
    const backButton = document.getElementById('backButton');
    backButton.addEventListener('click', () => {
      window.location.href = '/game';
    });
  </script>
</body>
</html>
