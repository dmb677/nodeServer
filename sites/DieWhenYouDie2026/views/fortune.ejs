<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Fortune Teller</title>
    <style>
        :root {
            color-scheme: dark;
            font-family: Georgia, serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 1rem;
            background: #070707;
            color: #f7edff;
        }

        main {
            width: min(92vw, 620px);
            padding: clamp(1.25rem, 4vw, 2.5rem);
            border: 1px solid #f16060;
            border-radius: 18px;
            background: #351217;
            box-shadow: 0 18px 60px #0008;
        }

        h1 {
            margin-top: 0;
            margin-bottom: 0.75rem;
            color: #b5b5b6;
            text-align: center;
            font-size: clamp(1.8rem, 6vw, 2.6rem);
        }

        p {
            line-height: 1.5;
            margin: 0.8rem 0;
        }

        .note {
            font: 0.85rem system-ui, sans-serif;
            color: #cbbbd8;
            text-align: center;
        }

        form {
            margin-top: 1rem;
        }

        label {
            display: block;
            margin: 1rem 0 .35rem;
            font: 600 1rem system-ui, sans-serif;
        }

        input,
        select,
        button {
            box-sizing: border-box;
            width: 100%;
            padding: .9rem 1rem;
            border: 1px solid #9876bd;
            border-radius: 10px;
            font-size: 1rem;
        }

        input,
        select {
            background: #130d22;
            color: white;
        }

        button {
            margin-top: 1.4rem;
            background: #c87cf0;
            color: #180b25;
            border: 0;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #dfadfa;
        }

        button:disabled {
            cursor: wait;
            opacity: .7;
        }

        @media (max-width: 480px) {
            body {
                padding: 0.75rem;
            }

            main {
                width: min(100%, 620px);
                border-radius: 14px;
            }

            .note {
                font-size: 0.8rem;
            }

            input,
            select,
            button {
                font-size: 1.05rem;
            }
        }
    </style>
</head>

<body>
    <main>
        <h1>✦ Death Awaits us All ✦</h1>
        <p class="note">Do you dare to see what your future holds.</p>
        <form id="fortune-form">
            <label for="name">What is your first name?</label>
            <input id="name" name="name" required maxlength="60" autocomplete="name">

            <label for="month">What month were you born?</label>
            <select id="month" name="month" required>
                <option value="">Choose a month</option>
                <option>January</option>
                <option>February</option>
                <option>March</option>
                <option>April</option>
                <option>May</option>
                <option>June</option>
                <option>July</option>
                <option>August</option>
                <option>September</option>
                <option>October</option>
                <option>November</option>
                <option>December</option>
            </select>

            <label for="day">What day were you born?</label>
            <input id="day" name="day" type="number" min="1" max="31" required>
            <button type="submit">Kill Me</button>
        </form>
        <p class="note">May God have mercy on your pathetic soul</p>
    </main>
    <script>
        const form = document.getElementById('fortune-form');

        form.addEventListener('submit', (event) => {
            event.preventDefault();
            const name = document.getElementById('name').value.trim();
            const month = document.getElementById('month').value;
            const day = Number(document.getElementById('day').value);
            if (!name || !month || day < 1 || day > 31) return;

            fetch('/f/lookup?' + new URLSearchParams({
                    name,
                    month,
                    day: String(day)
                }))
                .then(response => response.json())
                .then(() => {
                    window.location.href = '/future';
                })
                .catch(error => {
                    console.error('Error fetching horoscope:', error);
                    alert('An error occurred while fetching your fortune. Please try again.');
                });
        });
    </script>
</body>

</html>