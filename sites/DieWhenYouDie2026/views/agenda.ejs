<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Coming soon</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top, #330000 0%, #000000 60%),
                  linear-gradient(180deg, rgba(100,0,0,0.9) 0%, rgba(0,0,0,0.95) 100%);
      color: #ffdddd;
      font-family: "Helvetica Neue", Arial, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
    }

    .blood {
      position: absolute;
      width: 120%;
      height: 120%;
      top: -10%;
      left: -10%;
      background-image:
        radial-gradient(circle at 20% 20%, rgba(255,0,0,0.9) 0%, transparent 16%),
        radial-gradient(circle at 80% 30%, rgba(220,0,0,0.85) 0%, transparent 14%),
        radial-gradient(circle at 40% 70%, rgba(180,0,0,0.8) 0%, transparent 18%),
        radial-gradient(circle at 70% 80%, rgba(240,10,10,0.9) 0%, transparent 12%);
      filter: blur(2px);
      mix-blend-mode: screen;
      pointer-events: none;
    }

    .message {
      position: relative;
      z-index: 1;
      width: 90%;
      max-width: 900px;
      padding: 40px;
      border: 3px solid rgba(255, 0, 0, 0.7);
      box-shadow: 0 0 60px rgba(255, 0, 0, 0.25);
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(6px);
    }

    h1 {
      margin: 0;
      font-size: clamp(3rem, 8vw, 8rem);
      line-height: 1;
      letter-spacing: 0.25rem;
      font-weight: 900;
      color: #ff4444;
      text-shadow: 0 0 30px rgba(255, 0, 0, 0.8), 0 0 80px rgba(0, 0, 0, 0.7);
    }
  </style>
</head>
<body>
  <div class="blood"></div>
  <div class="message">
    <h1>Coming soon</h1>
  </div>
</body>
</html>
