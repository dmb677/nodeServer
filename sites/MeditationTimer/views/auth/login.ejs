<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs', { title: 'Log in' }) %>
<body>
    <main class="auth-shell">
        <a class="brand auth-brand" href="/"><span class="brand-mark" aria-hidden="true">◌</span><span>still<span class="brand-period">.</span></span></a>
        <section class="auth-card" aria-labelledby="auth-title">
            <p class="eyebrow">Welcome back</p>
            <h1 id="auth-title">Find your stillness.</h1>
            <p class="intro">Log in to begin your meditation.</p>
            <form action="/auth/signin" method="POST" class="auth-form">
                <label for="name">Username</label>
                <input id="name" name="name" type="text" autocomplete="username" required>
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required>
                <button class="button button-primary" type="submit">Log in</button>
            </form>
            <% if (locals.Message) { %>
                <p class="form-message" role="alert"><%= Message %><%= Username || '' %></p>
            <% } %>
            <p class="auth-switch">New to Still? <a href="/auth/signup">Create an account</a></p>
            <a class="back-link" href="/">Back to home</a>
        </section>
        <%- include('../partials/footer.ejs') %>
    </main>
</body>
</html>
